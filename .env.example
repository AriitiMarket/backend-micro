# Environment: development, staging, production
NODE_ENV=development

# Database
MONGO_PASSWORD=admin123
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/aritii?authSource=admin
POSTGRES_PASSWORD=postgres

# Cluster credentials (per-caller map) — docker compose up fails without it.
# One secret per service, e.g. from: openssl rand -hex 24
# INTERNAL_SERVICE_TOKENS=gateway:<secret>,identity:<secret>,commerce:<secret>,delivery:<secret>

# Cache
REDIS_PASSWORD=redis123
REDIS_URI=redis://:redis123@redis:6379

# Services
COMMERCE_SERVICE_PORT=3001
DELIVERY_SERVICE_PORT=3002
IDENTITY_SERVICE_PORT=3003
API_GATEWAY_PORT=3000

# Service URLs (for inter-service communication)
API_GATEWAY_URL=http://localhost:3000
COMMERCE_SERVICE_URL=http://localhost:3001
DELIVERY_SERVICE_URL=http://localhost:3002
IDENTITY_SERVICE_URL=http://localhost:3003

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Cloudinary (for image hosting)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Logging
LOG_LEVEL=info

# Development
DEBUG=aritii:*
