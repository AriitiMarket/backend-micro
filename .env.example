# ==============================================================================
# Aritii Market Platform - Production & Development Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this template to .env:
#      cp .env.example .env
# 2. Generate cluster service tokens using the provided script:
#      ./scripts/generate-tokens.sh
# 3. Generate Identity Service RS256 RSA key pair:
#      ./scripts/generate-keys.sh
# 4. Fill in secure passwords and secrets before deploying to production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Global Platform Settings
# ------------------------------------------------------------------------------
# Runtime environment: production, staging, development
NODE_ENV=production

# Gateway public listening port (single edge entry point)
PORT=3000

# Logging severity: error, warn, info, http, debug
LOG_LEVEL=info

# Allowed frontend origins for CORS (comma-separated list or wildcard '*')
# Example for production: https://aritii.market,https://admin.aritii.market
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Database & Data Stores (Credentials & Connection URIs)
# ------------------------------------------------------------------------------
# PostgreSQL (Identity Service Database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=aritii_identity
# Full database URL constructed from above (used by identity-service)
DATABASE_URL=postgresql://postgres:your_strong_postgres_password_here@postgres:5432/aritii_identity

# MongoDB 7 (Commerce & Delivery Database, Replica Set rs0)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_PASSWORD=your_strong_mongo_password_here
MONGO_INITDB_DATABASE=aritii
# MONGODB_URI points to the replica set member with authSource=admin
MONGODB_URI=mongodb://admin:your_strong_mongo_password_here@mongodb:27017/aritii?authSource=admin&replicaSet=rs0

# Redis (Caching, Rate Limiting, and Pub/Sub)
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_URI=redis://:your_strong_redis_password_here@redis:6379

# ------------------------------------------------------------------------------
# 3. Internal Service-to-Service Cluster Credentials
# ------------------------------------------------------------------------------
# High-entropy credential map isolating caller authority.
# Format: gateway:<token>,identity:<token>,commerce:<token>,delivery:<token>
# Generate a new secure map using: ./scripts/generate-tokens.sh
INTERNAL_SERVICE_TOKENS=gateway:replace_with_64hex_token,identity:replace_with_64hex_token,commerce:replace_with_64hex_token,delivery:replace_with_64hex_token

# Legacy single-token fallback (MUST remain empty in templates/committed files)
INTERNAL_SERVICE_TOKEN=

# ------------------------------------------------------------------------------
# 4. JWT & Cryptographic Keys
# ------------------------------------------------------------------------------
# Symmetric secret fallback (legacy / dev)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# RS256 Key Pair for Identity Service:
# The service signs JWTs using an RS256 private key and serves JWKS public keys.
# Run `./scripts/generate-keys.sh` to generate `./identity-service/src/config/keys/private.pem`
# and `./identity-service/src/config/keys/public.pem`.
# Alternatively, in container platforms (Kubernetes / ECS / Cloud Run), supply the
# raw PEM keys directly via the environment variables below (newlines can be \n):
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 5. Inter-Service Network Topologies (Internal Microservice URLs)
# ------------------------------------------------------------------------------
# In Docker Compose, these use internal container DNS names and internal ports.
# For bare-metal development without Docker, set these to http://localhost:3001, etc.
API_GATEWAY_URL=http://api-gateway:3000
COMMERCE_SERVICE_URL=http://commerce-service:3001
DELIVERY_SERVICE_URL=http://delivery-service:3002
IDENTITY_SERVICE_URL=http://identity:3003
GATEWAY_URL=http://api-gateway:3000

# ------------------------------------------------------------------------------
# 6. External Third-Party Integrations
# ------------------------------------------------------------------------------
# Cloudinary (Media storage for product images, user avatars, verification docs)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# SMTP / Email Service (Optional for order notifications and password resets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@aritii.market
