# ─────────────────────────────────────────────────────────────────────────────
# Aritii Market — root environment for `docker compose`.
#
# Copy to `.env` (git-ignored) and adjust. Nothing in this file is a source
# file: docker-compose.yml reads these values and injects them into the
# containers, so the same images run in local Docker, CI, staging and cloud with
# no code change. Only the values differ.
#
#   cp .env.example .env
#   # then generate real secrets:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Service discovery ────────────────────────────────────────────────────────
# Docker service names resolve on the private bridge network. In the cloud point
# these at the internal load balancer / service mesh / private endpoints of the
# managed platform. NEVER hard-code these anywhere in the source.
IDENTITY_SERVICE_URL=http://identity:8001
COMMERCE_SERVICE_URL=http://commerce-service:8002
DELIVERY_SERVICE_URL=http://delivery-service:8003
GATEWAY_URL=http://api-gateway:8000

# ── Service-to-service credentials ───────────────────────────────────────────
# One secret per caller. A service only ever SENDS its own secret, so a leaked
# credential authorises exactly one caller identity instead of the whole cluster.
# Every service VALIDATES inbound requests against this whole map: the caller
# named in `x-internal-service` must present the token issued to it.
#
# Generate distinct values:  openssl rand -hex 32
INTERNAL_SERVICE_TOKENS={"gateway":"replace-with-gateway-secret","identity":"replace-with-identity-secret","commerce":"replace-with-commerce-secret","delivery":"replace-with-delivery-secret"}

# Identity JWT signer key is mounted read-only and excluded from its image.
# Default is the local generated key under identity-service/src/config/keys.
# Set this to a deployment-managed key file path outside development.
IDENTITY_PRIVATE_KEY_PATH=./identity-service/src/config/keys/private.pem

# ── Outbound call budgets (ms) ───────────────────────────────────────────────
INTERNAL_CALL_TIMEOUT_MS=5000

# ── Published ports (host side) ──────────────────────────────────────────────
API_GATEWAY_PORT=8000
