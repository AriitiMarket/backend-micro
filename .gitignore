# Aritii Market backend — repository root ignore rules.
#
# These apply to every service, including those that do not ship their own
# .gitignore (delivery-service). Per-service .gitignore files narrow this further.

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment & secrets ────────────────────────────────────────────────────
# Templates (.env.example) stay tracked; live values never do.
.env
.env.*
!.env.example

# ── Key material ─────────────────────────────────────────────────────────────
# The RS256 pair is generated per machine: node src/config/keys/generate.js
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build & test output ──────────────────────────────────────────────────────
dist/
build/
coverage/
.nyc_output/
.cache/
.eslintcache

# ── Uploads & generated media ────────────────────────────────────────────────
uploads/
public/uploads/
media/

# ── Databases ────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
dump/

# ── OS & editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.bak
