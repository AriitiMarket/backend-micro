# Identity Service — OAuth 2.1 / OIDC provider (Bearer tokens only, no cookies).
PORT=8001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aritii_identity

# ── PostgreSQL pool & startup resilience ─────────────────────────────────────
# `pg` ignores connect_timeout/connection_limit inside DATABASE_URL, so these are
# the knobs it actually honours. Values shown are the defaults; raise
# DB_CONNECT_TIMEOUT_MS on slow/cold-start machines so a cold boot is not
# mistaken for a database outage.
DB_CONNECT_TIMEOUT_MS=30000
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
DB_CONNECT_RETRY_DELAY_MS=3000
DB_CONNECT_RETRY_MAX_DELAY_MS=15000
DB_CONNECT_NOTICE_ATTEMPTS=10

# ── OAuth 2.1 / OIDC ──────────────────────────────────────────────────────────
# Short-lived access tokens; refresh tokens rotate on every use.
ACCESS_TOKEN_EXPIRES_IN=10m
ACCESS_TOKEN_EXPIRES_IN_SEC=600
AUTH_CODE_EXPIRES_IN_SEC=300
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
ISSUER=aritii-identity
AUDIENCE=aritii-market

# Registered first-party clients and (optionally) exact redirect URIs.
OAUTH_CLIENTS=aritii-eshop,aritii-admin-web
# OAUTH_REDIRECT_URIS=https://app.example.com/auth/callback

# ── Service-to-service ───────────────────────────────────────────────────────
# This service's own name, presented to peers as `x-internal-service`.
INTERNAL_SERVICE_NAME=identity
# Per-caller cluster credentials: {"<caller>":"<secret>"}. Inbound /internal/*
# requests must name a known caller and present the secret issued to that caller.
# Identity makes no outbound service calls, so it only needs this to VALIDATE.
# Generate with `openssl rand -hex 32`.
INTERNAL_SERVICE_TOKENS={"gateway":"replace-with-gateway-secret","identity":"replace-with-identity-secret","commerce":"replace-with-commerce-secret","delivery":"replace-with-delivery-secret"}
# Legacy single shared credential. NOT a JWT signing key. Only honoured while
# INTERNAL_SERVICE_TOKENS is empty, or with INTERNAL_ALLOW_SHARED_TOKEN=true.
INTERNAL_SERVICE_TOKEN=

# ── Onboarding lifecycle (abandoned-application sweep) ───────────────────────
# A seller/provider who registers but never finishes the store/vehicle wizard is
# reclaimed by a background sweep once their PENDING application is this old. A
# SUBMITTED application is never touched — it is under review, not abandoned.
ONBOARDING_ABANDON_AFTER_DAYS=30
# Sweep cadence in ms (default 6h). Set to 0 to disable the scheduler; the
# on-demand POST /internal/onboarding/cleanup route still works.
ONBOARDING_CLEANUP_INTERVAL_MS=21600000
# Run one pass shortly after boot.
ONBOARDING_CLEANUP_RUN_ON_START=true
# Also archive the (now empty) accounts whose abandoned application was removed.
ONBOARDING_CLEANUP_ARCHIVE_ACCOUNTS=false
# Max memberships reclaimed per pass.
ONBOARDING_CLEANUP_BATCH_LIMIT=500

# ── Cloudinary (avatar uploads) ──────────────────────────────────────────────
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Only the API Gateway should be able to reach this service.
CORS_ORIGIN=http://localhost:8000
