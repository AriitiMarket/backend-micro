# Commerce Service (shops, products, orders, cart, disputes, analytics).
#
# Bare-metal development. Under Docker/CI/cloud these come from the orchestrator
# (repository root .env.example + docker-compose.yml).
PORT=8002
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/ariti_commerce

# ── Service topology ─────────────────────────────────────────────────────────
# Commerce calls Identity and Delivery DIRECTLY over the private network (no
# gateway hop) using its internal API. There is no hard-coded peer address in src/.
IDENTITY_SERVICE_URL=http://localhost:8001
DELIVERY_SERVICE_URL=http://localhost:8003
# The gateway is kept only for the endpoint it uniquely owns: the Socket.IO fan-out.
GATEWAY_URL=http://localhost:8000

# ── Service-to-service credentials ───────────────────────────────────────────
# This service's own name, presented to peers as `x-internal-service`.
INTERNAL_SERVICE_NAME=commerce
# Peers validate inbound calls against this whole map; Commerce only ever SENDS
# its own secret. A leaked credential therefore cannot impersonate another service.
INTERNAL_SERVICE_TOKENS={"gateway":"replace-with-gateway-secret","identity":"replace-with-identity-secret","commerce":"replace-with-commerce-secret","delivery":"replace-with-delivery-secret"}
# Legacy single shared credential. NOT a JWT signing key. Only honoured while
# INTERNAL_SERVICE_TOKENS is empty, or with INTERNAL_ALLOW_SHARED_TOKEN=true.
INTERNAL_SERVICE_TOKEN=

# Per-dependency call budgets (ms); INTERNAL_CALL_TIMEOUT_MS is the platform-wide
# default applied by the shared internal client.
INTERNAL_CALL_TIMEOUT_MS=5000

# Cloudinary (image uploads) — optional but recommended.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CORS_ORIGIN=http://localhost:3000
