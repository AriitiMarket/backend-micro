# API Gateway (public entry point — the ONLY published port).
#
# Bare-metal development. In Docker/CI/cloud the values come from the orchestrator
# (see the repository root .env.example and docker-compose.yml) — this file is the
# same contract for a laptop running the services with `npm run dev`.
PORT=8000
NODE_ENV=development

# ── Service topology ─────────────────────────────────────────────────────────
# Every upstream is resolved from these variables. There is no hard-coded
# hostname or port anywhere in src/.
IDENTITY_SERVICE_URL=http://localhost:8001
COMMERCE_SERVICE_URL=http://localhost:8002
DELIVERY_SERVICE_URL=http://localhost:8003

# ── Service-to-service credentials ───────────────────────────────────────────
# This gateway's own name, presented to services as `x-internal-service`.
INTERNAL_SERVICE_NAME=gateway
# Per-caller credential map: {"<caller>":"<secret>"}.
#   * outbound: the gateway signs every downstream request with ITS OWN secret;
#   * inbound : /internal/* requires a known caller presenting ITS OWN secret.
# Generate distinct values with `openssl rand -hex 32`.
INTERNAL_SERVICE_TOKENS={"gateway":"replace-with-gateway-secret","identity":"replace-with-identity-secret","commerce":"replace-with-commerce-secret","delivery":"replace-with-delivery-secret"}
# Legacy single shared credential. NOT a JWT signing key. Only honoured while
# INTERNAL_SERVICE_TOKENS is empty, or with INTERNAL_ALLOW_SHARED_TOKEN=true.
INTERNAL_SERVICE_TOKEN=

# Allowed origins for REST and Socket.io. Use '*' to allow all frontend URLs, or a comma-separated list.
CORS_ORIGIN=*

# ── Optional tuning ──────────────────────────────────────────────────────────
GATEWAY_PROXY_TIMEOUT_MS=30000
GATEWAY_MAX_BODY_BYTES=12582912
GATEWAY_HEALTH_TIMEOUT_MS=3000
# How long a service stays marked unavailable after a connection failure, so the
# next request fails fast (503 + Retry-After) instead of opening a doomed socket.
GATEWAY_UNAVAILABLE_TTL_MS=2000
RATE_LIMIT_AUTH_ENDPOINT_MAX=100
